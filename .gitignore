# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# PyInstaller intermediates
build/
dist/

# Packaged deliverable (regenerated by ab_poller/build_windows.py)
dist_package/

# Compiled binaries and backups (build output — often large)
*.exe
*.bak
*.backup
*.old

# Databases / live operational data — never commit
*.db
*.db-journal
*.sqlite
*.sqlite3

# Runtime output folders
/exports/
/scans/
/plc_scans/
/data/
/debug/

# Test / log noise
.pytest_cache/
*.log
*.tmp

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Agent / local tooling
.claude/
ab_poller/.claude/

# Scratch / audit temp
tmp_aud/
